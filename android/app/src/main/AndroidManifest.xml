<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Smart Expense Tracker"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartExpenseTracker">

        <!-- Splash & Purpose Screen (Initial Launcher) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Screens -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SignUpActivity"
            android:exported="false" />

        <!-- Main Dashboard: Spending card, recent expenses, filter chips -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Scan Receipt Screen: Camera/Gallery OCR, Auto-parsing, AI Classification -->
        <activity
            android:name=".ui.ScanReceiptActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Analytics Screen: MPAndroidChart Category Pie Chart & Breakdown -->
        <activity
            android:name=".ui.AnalyticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- FileProvider for high-resolution camera photo captures -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
