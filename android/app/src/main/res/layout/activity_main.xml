<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp">

        <!-- Top App Bar: Row 1 - User Greeting & Top Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Personalized User Greeting -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvUserGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, User 👋"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Expense Tracker"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <!-- Top Right: Prizes & Logout Pills -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRewards"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🏆 Prizes"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#D97706"
                    app:backgroundTint="#FEF3C7"
                    app:strokeColor="#FCD34D"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Log Out"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    app:backgroundTint="#FEE2E2"
                    app:strokeColor="#FECACA"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Top App Bar: Row 2 - Quick Settings (Currency & Budget Target) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeCurrency"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Currency"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetBudget"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🎯 Set Budget Limit"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Luxury Gradient Monthly Spending Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_gradient_background"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header Row: Title & Status Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MONTHLY EXPENSES"
                        android:textColor="#C7D2FE"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBudgetStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Safe (Under Budget)"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_glass_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalSpending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <!-- Remaining Budget & Percentage Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvRemainingBudget"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💰 Remaining: Rs. 0.00"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBudgetPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% Spent"
                        android:textColor="#C7D2FE"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbBudgetProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:progressDrawable="@drawable/progress_budget"
                    android:progress="0"
                    android:max="100"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvBudgetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spent 0.00 of 500.00 monthly budget"
                    android:textColor="#A5B4FC"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

                <!-- Action Buttons Inside Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanReceipt"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="📷 Scan Receipt"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#FFFFFF"
                        android:textColor="@color/primary"
                        app:elevation="2dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAnalytics"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="📊 Analytics"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#312E81"
                        android:textColor="#FFFFFF"
                        app:elevation="2dp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section Title: Recent Expenses -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Transactions"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    app:chipCornerRadius="16dp"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFood"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="🍔 Food" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTravel"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="✈️ Travel" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBills"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="📄 Bills" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipShopping"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipCornerRadius="16dp"
                    android:text="🛍️ Shopping" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Empty State Message -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧾\n\nNo expenses recorded yet.\nTap '📷 Scan Receipt' or '+' to start tracking!"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:visibility="gone" />

        <!-- List of Expenses -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <!-- Floating Action Button for Manual Entry -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="Add Expense"
        app:icon="@android:drawable/ic_input_add"
        app:backgroundTint="@color/primary"
        android:textColor="#FFFFFF"
        app:iconTint="#FFFFFF"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
